{
  "name": "emifoot",
  "private": true,
  "license": "MIT",
  "version": "1.1.5",
  "description": "A DOS-inspired football management game with solo careers and live multiplayer.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12 <23 || >=24 <25",
    "pnpm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fast": "VITE_LOCAL_FAST_MODE=true vite",
    "dev:server": "pnpm build:server && node server-dist/index.js",
    "dev:server:fast": "EMIFOOT_LOCAL_FAST_MODE=true pnpm build:server && NODE_ENV=development EMIFOOT_LOCAL_FAST_MODE=true node server-dist/index.js",
    "build": "tsc -b && vite build",
    "build:server": "vite build --ssr server/index.ts --outDir server-dist",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "pnpm build:server && node scripts/test-server-security.mjs",
    "test:simulation": "vitest run src/game/simulation.test.ts",
    "test:economy": "vitest run src/game/economy.metrics.test.ts src/game/transfer.economy.test.ts src/game/prizes.test.ts src/game/sponsorship.test.ts",
    "check": "pnpm lint && pnpm lint:unused && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && pnpm test:server && pnpm test:release",
    "data:refresh": "node scripts/fetch-rosters.mjs && node scripts/fetch-libertadores-rosters.mjs",
    "data:refresh:libertadores": "node scripts/fetch-libertadores-rosters.mjs",
    "preview": "vite preview",
    "start:server": "node server-dist/index.js",
    "lint:unused": "knip",
    "test:e2e": "playwright test",
    "test:release": "node --test scripts/install-release.test.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "knip": "6.38.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
